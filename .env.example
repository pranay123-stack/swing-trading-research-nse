# Kotak Neo Trade API — MARKET DATA ONLY. This project never places orders.
#
# The current Kotak Neo API (v2) authenticates market-data endpoints (scrip master, quotes, historical candles) with the
# token shown in your NEO app -> Trade API dashboard. That token is all `run_research.py` needs if KOTAK_BASE_URL is set.
#
# The spec's KOTAK_CONSUMER_KEY / CONSUMER_SECRET / PASSWORD fields belong to the older v1 SDK flow and are not used by v2:
#   consumer key  -> KOTAK_ACCESS_TOKEN (the API dashboard token)
#   consumer secret, password -> not used (v2 logs in with mobile + UCC + TOTP + MPIN)
KOTAK_ACCESS_TOKEN=

# Base URL returned by /tradeApiValidate (e.g. https://e22.kotaksecurities.com). If set, no login is needed.
KOTAK_BASE_URL=

# Only needed when KOTAK_BASE_URL is empty: the client then logs in once to discover the base URL.
KOTAK_MOBILE=
KOTAK_UCC=
KOTAK_MPIN=
# Base32 TOTP secret from the Kotak authenticator registration (leave empty if you don't have it).
KOTAK_TOTP_SECRET=

# Any variable that tries to enable live trading (KOTAK_LIVE_TRADING_ENABLED, LIVE_TRADING, EXECUTION_MODE, ...)
# makes the application refuse to start. Execution mode is hard-coded to PAPER in config.py.
